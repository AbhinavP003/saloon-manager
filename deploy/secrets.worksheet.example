# Local secrets worksheet — copy to deploy/secrets.worksheet (gitignored) and fill in.
# NEVER commit real values.

PROJECT_ID=saloon-manager-beta-5640
REGION=asia-south1
SQL_CONNECTION=saloon-manager-beta-5640:asia-south1:saloon-db
DB_USER=saloon_user
DB_NAME=saloon
DB_PASSWORD=CHANGE_ME_alphanumeric_only
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# Cloud SQL socket URL for Cloud Run:
DATABASE_URL=postgresql+asyncpg://saloon_user:CHANGE_ME@/saloon?host=/cloudsql/saloon-manager-beta-5640:asia-south1:saloon-db

# Fill after deploy:
BACKEND_URL=
FRONTEND_URL=
