# Copy to deploy/.env on the GCE VM (never commit deploy/.env).
# Replace YOUR_VM_IP with the VM external IP or http://your-domain.

POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=saloon_db

# Internal Docker network — backend connects to the db service.
DATABASE_URL=postgresql+asyncpg://admin:change-me-strong-password@db:5432/saloon_db

# openssl rand -hex 32
SECRET_KEY=change-me-secret-key

# Public origin(s) for browser CORS (comma-separated if needed).
BACKEND_CORS_ORIGINS=http://YOUR_VM_IP

# Baked into frontend at build time — base URL only (api.ts appends /api/v1).
NEXT_PUBLIC_API_URL=http://YOUR_VM_IP

# Pre-built images from Cloud Build (recommended on e2-micro — avoids OOM during build).
BACKEND_IMAGE=asia-south1-docker.pkg.dev/saloon-manager-beta-5640/saloon-repo/saloon-backend:gce
FRONTEND_IMAGE=asia-south1-docker.pkg.dev/saloon-manager-beta-5640/saloon-repo/saloon-frontend:gce
